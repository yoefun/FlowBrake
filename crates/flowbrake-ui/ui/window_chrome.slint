import { CheckBoxSlot } from "widgets.slint";

component ChromeIcon inherits Image {
    in property <string> kind;
    in property <bool> restore;
    in property <color> line-color;
    source: root.kind == "settings" ? @image-url("../../../assets/titlebar/settings.svg")
        : root.kind == "minimize" ? @image-url("../../../assets/titlebar/minus.svg")
        : root.kind == "close" ? @image-url("../../../assets/titlebar/x.svg")
        : root.restore ? @image-url("../../../assets/titlebar/copy.svg")
        : @image-url("../../../assets/titlebar/square.svg");
    colorize: root.line-color;
    image-fit: contain;
}

component SettingsMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback activate();
    height: 32px;
    background: hit.has-hover ? #edf2f7 : transparent;

    hit := TouchArea {
        clicked => {
            root.activate();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-color: root.selected ? #315f90 : #9aa8b8;
            border-width: 1px;
            border-radius: 8px;
            background: root.selected ? #315f90 : transparent;

            if (root.selected) : Rectangle {
                width: 6px;
                height: 6px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #ffffff;
                border-radius: 3px;
            }
        }

        Text {
            text: root.text;
            color: #24303f;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component SettingsCheckItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);
    height: 32px;
    background: hit.has-hover ? #edf2f7 : transparent;

    hit := TouchArea {
        clicked => {
            root.toggled(!root.checked);
        }
    }

    VerticalLayout {
        height: parent.height;

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;

            CheckBoxSlot {
                checked: root.checked;
                toggled(value) => {
                    root.toggled(value);
                }
            }

            Text {
                text: root.text;
                height: 18px;
                color: #24303f;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

export component SettingsDropdown inherits Rectangle {
    in property <bool> speed-unit-bits;
    in property <bool> ipv6-enabled;
    in property <int> language-choice;
    callback language-changed(int);
    callback speed-unit-bits-changed(bool);
    callback ipv6-enabled-changed(bool);
    callback close-requested();

    width: 240px;
    height: menu.preferred-height;
    background: #ffffff;
    border-color: #d7e0eb;
    border-width: 1px;
    border-radius: 6px;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000025;
    clip: true;

    menu := VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 0px;

        HorizontalLayout {
            height: 18px;
            padding-left: 12px;
            padding-right: 12px;

            Text {
                text: @tr("Speed units");
                color: #65758b;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        SettingsMenuItem {
            text: @tr("ISP units (Kb/s)");
            selected: root.speed-unit-bits;
            activate => {
                root.speed-unit-bits-changed(true);
                root.close-requested();
            }
        }

        SettingsMenuItem {
            text: @tr("Standard units (KB/s)");
            selected: !root.speed-unit-bits;
            activate => {
                root.speed-unit-bits-changed(false);
                root.close-requested();
            }
        }

        Rectangle {
            height: 9px;

            Rectangle {
                y: 4px;
                height: 1px;
                background: #e4eaf2;
            }
        }

        HorizontalLayout {
            height: 18px;
            padding-left: 12px;
            Text {
                text: @tr("Language");
                color: #65758b;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        SettingsMenuItem {
            text: @tr("Follow system");
            selected: root.language-choice == 0;
            activate => { root.language-changed(0); root.close-requested(); }
        }
        SettingsMenuItem {
            text: "简体中文";
            selected: root.language-choice == 1;
            activate => { root.language-changed(1); root.close-requested(); }
        }
        SettingsMenuItem {
            text: "English";
            selected: root.language-choice == 2;
            activate => { root.language-changed(2); root.close-requested(); }
        }
        Rectangle {
            height: 9px;
            Rectangle { y: 4px; height: 1px; background: #e4eaf2; }
        }
        SettingsCheckItem {
            text: @tr("IPv6 support");
            checked: root.ipv6-enabled;
            toggled(enabled) => {
                root.ipv6-enabled-changed(enabled);
            }
        }
    }
}

export component SettingsButton inherits Rectangle {
    callback clicked();
    in property <bool> active;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: @tr("Settings");
    accessible-action-default => { root.clicked(); }

    width: 40px;
    height: 40px;
    background: hit.pressed ? #e3e6eb : root.active ? #eaf2ff : hit.has-hover ? #f2f4f7 : transparent;

    keyboard := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    if keyboard.has-focus: Rectangle {
        x: 3px; y: 3px;
        width: parent.width - 6px; height: parent.height - 6px;
        border-radius: 4px; border-width: 1px;
        border-color: #1d5fd1; background: transparent;
    }

    Timer {
        interval: 600ms;
        running: hit.has-hover && !hit.pressed && !root.active;
        triggered => { tooltip.show(); }
    }

    tooltip := PopupWindow {
        x: -16px;
        y: 44px;
        width: 84px;
        height: 28px;
        Rectangle {
            background: #20242c;
            border-radius: 4px;
            Text {
                text: @tr("Settings");
                color: white;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    hit := TouchArea {
        changed has-hover => { if !self.has-hover { tooltip.close(); } }
        clicked => {
            tooltip.close();
            root.clicked();
        }
    }

    ChromeIcon {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: "settings";
        line-color: #28313d;
    }
}

export component WindowControlButton inherits Rectangle {
    in property <string> kind;
    in property <bool> restore: false;
    callback clicked();
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.kind == "minimize" ? @tr("Minimize")
        : root.kind == "close" ? @tr("Close")
        : root.restore ? @tr("Restore") : @tr("Maximize");
    accessible-action-default => { root.clicked(); }

    width: 46px;
    height: 40px;
    background: !hit.has-hover ? transparent
        : root.kind == "close"
            ? (hit.pressed ? #a82424 : #d83b3b)
            : (hit.pressed ? #d5dde8 : #edf2f7);

    property <color> icon-color: root.kind == "close" && hit.has-hover ? #ffffff : #28313d;

    keyboard := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    if keyboard.has-focus: Rectangle {
        x: 3px; y: 3px;
        width: parent.width - 6px; height: parent.height - 6px;
        border-radius: 4px; border-width: 1px;
        border-color: #1d5fd1; background: transparent;
    }

    hit := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    ChromeIcon {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.kind;
        restore: root.restore;
        line-color: root.icon-color;
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> maximized;
    in property <bool> speed-unit-bits;
    in-out property <bool> settings-open: false;
    property <bool> drag-started: false;
    callback drag-requested();
    callback maximize-toggle-requested();
    callback minimize-requested();
    callback close-requested();
    callback speed-unit-bits-changed(bool);

    height: 40px;
    background: #ffffff;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #e3e6eb;
    }

    HorizontalLayout {
        padding-left: 14px;
        spacing: 0px;

        Image {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../../assets/app-icon.png");
            image-fit: contain;
        }

        Rectangle { width: 8px; }

        Text {
            text: root.title;
            width: 150px;
            height: parent.height;
            color: #20242c;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: parent.height;

            drag-hit := TouchArea {
                moved => {
                    if (self.pressed && !root.drag-started) {
                        root.drag-started = true;
                        root.drag-requested();
                    }
                }
                changed pressed => {
                    if (!self.pressed) {
                        root.drag-started = false;
                    }
                }
                double-clicked => {
                    root.maximize-toggle-requested();
                }
            }
        }

        SettingsButton {
            active: root.settings-open;
            clicked => {
                root.settings-open = !root.settings-open;
            }
        }

        WindowControlButton {
            kind: "minimize";
            clicked => {
                root.minimize-requested();
            }
        }

        WindowControlButton {
            kind: "maximize";
            restore: root.maximized;
            clicked => {
                root.maximize-toggle-requested();
            }
        }

        WindowControlButton {
            kind: "close";
            clicked => {
                root.close-requested();
            }
        }
    }
}
